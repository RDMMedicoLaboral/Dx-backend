# Cadena de conexión de PostgreSQL (Render te la da automáticamente si usas render.yaml)
DATABASE_URL="postgresql://usuario:password@host:5432/diagnostic_os"

# Cualquier cadena larga y aleatoria. Cámbiala en producción.
JWT_SECRET="cambia-esto-por-algo-largo-y-aleatorio"

# Dominios permitidos a llamar a esta API, separados por coma.
# Ejemplo: https://tuusuario.github.io
CORS_ORIGINS="http://localhost:5173,https://tuusuario.github.io"

PORT=4000
NODE_ENV=development

# Cloudinary (imágenes, videos, PDFs — radiografías escaneadas, fotos de muestras, etc.)
# Los tres valores están en tu dashboard de Cloudinary, sección "Account Details".
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="tu-api-secret"

# Clave para cifrar en la base los secretos de integración (client_secret de OAuth2, claves de API).
# Si la dejas vacía se deriva de JWT_SECRET. Recomendado en producción: defínela aparte para que
# rotar JWT_SECRET no deje inservibles los secretos guardados. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENC_KEY=""

# Qué se envía al sistema conectado al publicar un informe:
#   clinicos = lo que Clinic-OS sabe recibir (cédula + orden original + texto del resultado). Predeterminado con OAuth2.
#   full     = FHIR completo con Observations y adjuntos. Predeterminado con clave de API.
# INTEGRATION_PAYLOAD_PROFILE=clinicos

# Administrador de plataforma (panel admin.html). Se crea/actualiza al arrancar el servidor.
# La contraseña debe tener al menos 12 caracteres. Para cambiarla, cambia este valor y reinicia.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# ADMIN_NAME="Tu nombre"
