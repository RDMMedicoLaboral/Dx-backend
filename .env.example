# Cadena de conexión de PostgreSQL (Render te la da automáticamente si usas render.yaml)
DATABASE_URL="postgresql://usuario:password@host:5432/diagnostic_os"

# Cualquier cadena larga y aleatoria. Cámbiala en producción.
JWT_SECRET="cambia-esto-por-algo-largo-y-aleatorio"

# Dominios permitidos a llamar a esta API, separados por coma.
# Ejemplo: https://tuusuario.github.io
CORS_ORIGINS="http://localhost:5173,https://tuusuario.github.io"

PORT=4000
NODE_ENV=development

# Cloudinary (imágenes, videos, PDFs — radiografías escaneadas, fotos de muestras, etc.)
# Los tres valores están en tu dashboard de Cloudinary, sección "Account Details".
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="tu-api-secret"

# Clave para poder cargar los datos de demo visitando una URL (útil en el plan
# gratuito de Render, que no da acceso a Shell). Cualquier texto largo sirve.
SEED_KEY="cambia-esto-por-otra-clave-larga"


